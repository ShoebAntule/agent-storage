# Node.js 24+, no database account or local LLM required.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/agentforge.sqlite
# Optional. Without this key, the editor, examples, grading and history still work.
# Choose: gemini or openai-compatible
AI_PROVIDER=gemini
AI_API_KEY=
# Set a currently available model ID from your provider's dashboard.
AI_MODEL=
# Optional comma-separated IDs to offer in the model selector. Same provider/key.
AI_MODELS=
# Only used for openai-compatible providers. For Vyce, confirm its API base in your dashboard.
AI_BASE_URL=
AI_REQUESTS_PER_ATTEMPT=15
AI_MAX_OUTPUT_TOKENS=2500
# Production only: HTTPS cookies; leave false on localhost HTTP.
COOKIE_SECURE=false
